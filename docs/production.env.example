# Production environment template for realtime dubbing.
# Copy this into your production secret manager or deployment platform.
# Do not commit a filled version of this file.
# Every replace-with/change-me/your-domain value is intentional placeholder text.
# `npm run check:production-config` must fail until all placeholders are replaced.

API_ENV=production
LIVE_TRANSLATE_MODE=aliyun
PORT=8787

# Aliyun DashScope / Model Studio
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
ALI_LIVE_TRANSLATE_ENDPOINT=wss://dashscope.aliyuncs.com/api-ws/v1/realtime

# Auth
CLIENT_TOKEN_SECRET=change-me-to-a-long-random-signing-secret
CLIENT_TOKEN_TTL_SECONDS=900

# Persistent server stores. Replace with durable mounted paths or database-backed equivalents.
BILLING_STORE_FILE=/var/lib/realtime-dubbing/billing.json
PAYMENT_LEDGER_FILE=/var/lib/realtime-dubbing/payment-ledger.json
PAYMENT_ORDER_STORE_FILE=/var/lib/realtime-dubbing/payment-orders.json

# Public site and Chrome Web Store
PUBLIC_SITE_BASE_URL=https://your-domain.example
CHROME_STORE_PRIVACY_POLICY_URL=https://your-domain.example/privacy

# Checkout and signed order status URLs
PAYMENT_CHECKOUT_BASE_URL=https://your-domain.example/pay
PAYMENT_STATUS_BASE_URL=https://api.your-domain.example
PAYMENT_CHECKOUT_TOKEN_SECRET=change-me-to-a-long-random-checkout-status-secret

# Payment verification must be production before commercial launch.
PAYMENT_VERIFICATION_MODE=production

# Alipay webhook verification
ALIPAY_PUBLIC_KEY_FILE=/etc/realtime-dubbing/alipay-public.pem

# WeChat Pay API v3 webhook verification
WECHATPAY_PLATFORM_CERT_SERIAL=replace-with-your-wechat-platform-certificate-serial
WECHATPAY_PLATFORM_CERT_FILE=/etc/realtime-dubbing/wechatpay-platform.pem
WECHATPAY_API_V3_KEY=replace-with-your-32-byte-wechatpay-api-v3-key

# Optional webhook HMAC for internal/development integrations only.
# PAYMENT_WEBHOOK_SECRET=change-me-if-using-development-hmac-webhooks
